<?xml version="1.0"?>
<odoo>
    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Property Offer Action</field>
        <field name="res_model">estate_property_offer</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="estate_property_offer_list" model="ir.ui.view">
        <field name="name">estate.property.offer.view.list</field>
        <field name="model">estate_property_offer</field>
        <field name="arch" type="xml">
            <list string="Offers" create="True">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>


</odoo>